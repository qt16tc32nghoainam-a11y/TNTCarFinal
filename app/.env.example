# Sao chép file này thành app/.env trên VM: cp .env.example .env
# Gmail: bật xác minh 2 bước và dùng App Password 16 ký tự (không dùng mật khẩu Gmail thường).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=TNT CAR <your-account@gmail.com>

# Web Push (thông báo đẩy lên thiết bị). Sinh cặp khóa riêng cho production bằng lệnh:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# rồi dán vào 2 biến dưới. Nếu để trống sẽ dùng cặp mặc định trong code (chỉ nên dùng để thử).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@tntcar.vn
