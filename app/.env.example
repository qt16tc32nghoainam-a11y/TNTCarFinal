# Sao chép file này thành app/.env trên VM: cp .env.example .env
# Gmail: bật xác minh 2 bước và dùng App Password 16 ký tự (không dùng mật khẩu Gmail thường).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=TNT CAR <your-account@gmail.com>
